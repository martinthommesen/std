{
  "name": "std",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "node tooling/typecheck.ts",
    "test": "vitest run",
    "test:canaries": "vitest run --config tooling/vitest.config.ts",
    "check": "ultracite check",
    "check:postgres": "node tooling/check-postgres.ts",
    "check:tooling": "node tooling/check-tsconfig.ts && node tooling/check-imports.ts && node tooling/check-lockfile.ts && node tooling/check-vendor.ts",
    "ci:local": "node tooling/ci-local.ts",
    "fix": "ultracite fix",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.3.12",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fast-check": "catalog:",
    "lefthook": "^2.2.2",
    "oxc-parser": "0.148.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "pnpm@12.14.0",
  "std": {
    "profile": "plain"
  }
}
