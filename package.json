{
  "name": "std",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "node tooling/typecheck.ts",
    "test": "vitest run",
    "test:tls": "sh tooling/test-postgres-tls.sh",
    "test:canaries": "vitest run --config tooling/vitest.config.ts",
    "check": "ultracite check && node tooling/check-foldkit-lint.ts",
    "check:postgres": "node tooling/check-postgres.ts",
    "check:tooling": "node tooling/check-tsconfig.ts && node tooling/check-imports.ts && node tooling/check-lockfile.ts && node tooling/check-vendor.ts && node tooling/check-oda-component-schema.ts && node tooling/check-conformance-matrix.ts && node tooling/check-migration-phases.ts",
    "ci:local": "node tooling/ci-local.ts",
    "ctk": "node tooling/ctk/run.ts",
    "fix": "ultracite fix",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "bench": "pnpm --filter @std/bench bench",
    "std": "node packages/server/src/cli/main.ts",
    "probes": "node packages/probes/src/main.ts",
    "oda-probe:summary": "node tooling/oda-canvas-probe-summary.ts",
    "spike:demo": "node examples/acme/src/main.ts",
    "helpdesk:seed": "node examples/helpdesk/src/seed.ts",
    "quickstart:ci": "node examples/quickstart/src/ci.ts",
    "tmf621-example:ci": "node examples/quickstart/src/tmf621-ci.ts",
    "ctk:ci": "node examples/quickstart/src/ctk-ci.ts",
    "release-compat:ci": "node examples/quickstart/src/release-compat.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@shadcn/lint": "^0.2.3",
    "@std/postgres": "workspace:*",
    "@std/tmf": "workspace:*",
    "@std/values": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.3.12",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fast-check": "catalog:",
    "lefthook": "^2.2.2",
    "libpg-query": "18.1.5",
    "oxc-parser": "0.148.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "packageManager": "pnpm@12.14.0",
  "std": {
    "profile": "plain"
  }
}
