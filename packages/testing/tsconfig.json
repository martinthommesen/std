{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/sql",
          "effect/http",
          "effect/http-api",
          "effect/observability",
          "@effect/sql-pg",
          "@effect/platform-node",
          "@effect/opentelemetry"
        ],
        "allowedExperimentalApis": [],
        "diagnosticSeverity": {
          "unstableApiUsage": "error",
          "experimentalApiUsage": "error",
          "outdatedApi": "error",
          "obsoleteSchemaImport": "error",
          "duplicatePackage": "error",
          "floatingEffect": "error"
        },
        "ignoreEffectWarningsInTscExitCode": false,
        "overrides": [
          {
            "include": ["test/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/sql",
                "effect/http",
                "effect/http-api",
                "effect/observability",
                "@effect/sql-pg",
                "@effect/platform-node",
                "@effect/opentelemetry",
                "@effect/vitest"
              ]
            }
          }
        ]
      }
    ]
  },
  "include": ["src", "test", "vitest.config.ts"]
}
